DB_DRIVER=mysql+pymysql
DB_USER=USERNAME
DB_PASSWORD=YOUR_RAW_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skill_assessment
# Set DB_SSL=true for managed cloud MySQL (e.g., TiDB Cloud Starter on port 4000)
DB_SSL=false

# Security & CORS (override JWT_SECRET and set CORS_ORIGINS to your Vercel frontend URL in production)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
CORS_ORIGINS=*

# AI Providers - Three-provider fallback chain: OpenRouter -> Groq -> Gemini
# OpenRouter (free, unlimited): https://openrouter.ai -> API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq (free, unlimited, very fast): https://console.groq.com -> API Keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini (free tier): https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=your_gemini_api_key_here
